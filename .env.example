# ============================================================
# Kingdom Creatives Platform - environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# Ground rule 0.6: every key below except the two NEXT_PUBLIC_
# Supabase values is server-side only and must never reach the browser.
# ============================================================

# ---- Supabase (project cyyxhhwuyeyvewqrhewt) ----
# The only two keys allowed in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://cyyxhhwuyeyvewqrhewt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server only. Used sparingly: Stripe webhook writes, sync jobs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---- Tenant resolution ----
# Apex the platform serves subdomains from: {slug}.ROOT_DOMAIN
KC_ROOT_DOMAIN=kingdom-creatives.com

# Fallback tenant for hosts that match nothing (localhost, *.vercel.app
# preview URLs). Leave EMPTY in production so an unmatched host 404s
# instead of silently serving another church's content.
# For local dev, set this to:  church-for-truckers
KC_DEFAULT_CHURCH_SLUG=

# Set to 1 to allow ?church=<slug> to override tenant resolution.
# Preview/dev only - never set this in production.
# For local dev, set this to:  1
KC_ALLOW_CHURCH_QUERY_OVERRIDE=

# ---- Phase E / later phases (unused in Phase A) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# YOUTUBE_API_KEY=
# BREVO_API_KEY=
# ANTHROPIC_API_KEY=
# ESV_API_KEY=
# NEXT_PUBLIC_APP_URL=https://kingdom-creatives.com
